{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "allowUnreachableCode": false,
        "declaration": false,
        "experimentalDecorators": true,
        "lib": [
            "dom",
            "es2022",
            "ESNext.Disposable"
        ],
        "moduleResolution": "node",
        "module": "esnext",
        "target": "es2017",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "jsx": "react",
        "jsxFactory": "h",
        "skipLibCheck": true
    },
    "include": [
        "src",
        "types/jsx.d.ts",
        "stories/types/markdown.d.ts"
    ],
    "exclude": [
        "node_modules",
        "angular",
        "react",
        "example"
    ]
}
